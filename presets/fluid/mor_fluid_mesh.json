{
  "site": {
    "site_title": "Creative Studio",
    "site_subtitle": "Digital design and interactive media.",
    "header_logo_url": "",
    "home_url": "/"
  },
  "colors": {
    "bg_base": "#0f172a",
    "bg_panel": { "mode": "Solid", "color": "#1e293bd9", "gradient_from": "#1e293bd9", "gradient_to": "#1e293bd9", "gradient_angle_deg": 180 },
    "bg_elevated": { "mode": "Solid", "color": "#334155d9", "gradient_from": "#334155d9", "gradient_to": "#334155d9", "gradient_angle_deg": 180 },
    "fg_base": "#f8fafc",
    "fg_muted": "#94a3b8",
    "accent": "#38bdf8",
    "border": "transparent"
  },
  "background": {
    "mode": { "Gradient": { "from": "#0f172a", "to": "#38bdf8", "angle_deg": 135 } }
  },
  "typography": {
    "body_font_stack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "heading_font_stack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "mono_font_stack": "ui-monospace, monospace",
    "base_size": "16px",
    "scale_ratio": "1.25",
    "line_height": "1.6",
    "heading_weight": "800"
  },
  "buttons": {
    "radius": "20px",
    "border_width": "0px",
    "text_transform": "none"
  },
  "preset_css": "/* Glassmorphism Inject */\n.mor-post, .runelite-panel, .main-header { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1); }\n.mor-post { margin-bottom: 24px; padding: 24px; }\n.header-top-row { border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important; }\n.panel-header { background: transparent; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }"
}